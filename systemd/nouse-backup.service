[Unit]
Description=nouse SQLite Backup
After=nouse-daemon.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'mkdir -p %h/.local/share/nouse/backups && sqlite3 %h/.local/share/nouse/field.sqlite ".backup '"'"'%h/.local/share/nouse/backups/field_$(date +%%Y%%m%%d_%%H%%M%%S).sqlite'"'"'"'
WorkingDirectory=/home/bjorn

[Install]
WantedBy=default.target
